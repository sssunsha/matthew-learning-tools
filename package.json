{
  "name": "matthew-learning-tools",
  "version": "0.0.20",
  "main": "electron.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:compress": "ng build --configuration production && node scripts/compress-build.js",
    "deploy": "npm run build:compress && node scripts/deploy-to-pages.js",
    "deploy:full": "npm run build:compress && node scripts/deploy-to-pages.js --full",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "electron .",
    "electron:dev": "concurrently \"ng serve\" \"wait-on http://localhost:4200 && cross-env NODE_ENV=development electron .\"",
    "electron:pack": "ng build --configuration production && electron-packager . MatthewTools --platform=darwin --arch=arm64 --out=release --overwrite --icon=public/app_icon.jpg",
    "android:debug": "node scripts/build-android.js debug",
    "android:release": "node scripts/build-android.js release",
    "android:run": "cd cordova-app && npx cordova run android",
    "android:emulate": "cd cordova-app && npx cordova emulate android"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.7.0",
  "build": {
    "appId": "com.matthew.learningtools",
    "productName": "MatthewTools",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.js",
      "package.json",
      "public/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/app_icon.jpg",
      "category": "public.app-category.education"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "public/app_icon.jpg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/app_icon.jpg",
      "category": "Education"
    }
  },
  "dependencies": {
    "@angular/animations": "^21.1.2",
    "@angular/cdk": "~21.1.2",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/material": "~21.1.2",
    "@angular/platform-browser": "^21.1.2",
    "@angular/router": "^21.1.0",
    "ngx-quill": "^30.0.1",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.0",
    "@angular/material": "^21.1.2",
    "compression-webpack-plugin": "^12.0.0",
    "concurrently": "^9.2.1",
    "cordova": "^13.0.0",
    "cross-env": "^7.0.3",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "electron-packager": "^17.1.2",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.3"
  }
}
